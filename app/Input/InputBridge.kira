// The input system's C surface, one declaration per export.
//
// The browser's keyboard is not the widget tree's: the page lives in a native
// child window on another thread, and once it has been clicked it is the only
// window in this process receiving keys. So the shortcuts are matched in a hook
// on each of the two message pumps, and what reaches Kira is the decision --
// "the user asked to reload", "this character belongs in the address bar" --
// rather than the keystroke.
//
// Nothing outside `app/Input` calls these: the files beside this one are where
// the rest of the browser finds them, in Kira types.

// --- Lifetime ---------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_input_frame; abi: c; }
function nativeInputFrame(hostWindow: RawPtr) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_input_shutdown; abi: c; }
function nativeInputShutdown() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_input_ready; abi: c; }
function nativeInputReady() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_input_error; abi: c; }
function nativeInputError() -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_input_revision; abi: c; }
function nativeInputRevision() -> I32;

// --- Events -----------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_input_next_event; abi: c; }
function nativeInputNextEvent() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_input_event_argument; abi: c; }
function nativeInputEventArgument() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_input_event_target; abi: c; }
function nativeInputEventTarget() -> I32;

