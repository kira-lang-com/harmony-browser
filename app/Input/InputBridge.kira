@FFI.Extern { library: harmony_browser; symbol: hb_input_chrome_text_target; abi: c; }
function nativeInputChromeTextTarget() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_input_set_chrome_text_target; abi: c; }
function nativeInputSetChromeTextTarget(target: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_input_focus_cycle; abi: c; }
function nativeInputFocusCycle(direction: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_input_press_serial; abi: c; }
function nativeInputPressSerial() -> I32;

