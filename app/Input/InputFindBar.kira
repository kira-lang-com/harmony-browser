import KiraUI

// The find bar: the strip Ctrl+F puts under the toolbar.
//
// It draws only while a find session is open, and it is the whole of the
// session's interface -- the query, how many matches it has, which one the page
// is showing, the two directions and the way out. Typing in it searches as it
// goes; the page scrolls and highlights under the typing.

function harmonyInputFindBarHeight() -> Float {
    return 32.0
}

function harmonyInputFindFieldWidth() -> Float {
    return 260.0
}

// The status text recedes while it is only counting and stands out when it is
// reporting that there is nothing to count.
function harmonyInputFindStatusInk() -> PrimaryColor {
    if harmonyInputFindQuery().count > 0 && harmonyInputFindHasResults() == false {
        return PrimaryColor.Accent
    }
    return PrimaryColor.Secondary
}

function harmonyInputFindFieldBorder() -> ThemeBorder {
    if harmonyInputFindHasKeyboard() {
        return ThemeBorder.Focus
    }
    return ThemeBorder.Subtle
}

// A direction button recedes while there is nothing to step through, exactly as
// back and forward do on the toolbar, rather than leaving the row.
function harmonyInputFindStepInk() -> PrimaryColor {
    if harmonyInputFindHasResults() {
        return PrimaryColor.Secondary
    }
    return PrimaryColor.Quaternary
}

Widget HarmonyInputFindStepButton(symbol: Symbol, action: () -> Void) {
    body {
        ControlSlot() {
            Icon(symbol)
                .imageScale(.Small)
                .foregroundColor(harmonyInputFindStepInk())
        }
        .onClick(action)
        .disabled(harmonyInputFindHasResults() == false)
    }
}

Widget HarmonyInputFindField() {
    body {
        Panel(radius = CornerRadius.Capsule) {
            HStack(spacing = Spacing.Small, alignment = VerticalAlignment.Center) {
                Icon(.MagnifyingGlass)
                    .imageScale(.Small)
                    .foregroundColor(.Secondary)

                TextField(
                    key = harmonyInputFindFieldKey(),
                    initial = "",
                    placeholder = "Find in page",
                    width = harmonyInputFindFieldWidth(),
                    height = 20.0,
                    onSubmit = harmonyInputFindNext
                )
                    .fill(Color { a: 0.0 })
                    .foregroundColor(.Primary)
                    .typography(.control)
            }
            .fillHeight()
            .inset(horizontal = Spacing.Small)
        }
        .backgroundStyle(.Control)
        .themeBorder(harmonyInputFindFieldBorder())
        .height(24.0)
    }
}

Widget HarmonyInputFindBar() {
    body {
        Panel(radius = CornerRadius.None) {
            HStack(spacing = Spacing.Small, alignment = VerticalAlignment.Center) {
                HarmonyInputFindField()

                Text(harmonyInputFindStatus())
                    .typography(.caption)
                    .foregroundColor(harmonyInputFindStatusInk())

                Spacer()

                HarmonyInputFindStepButton(
                    symbol = Symbol.CaretUp,
                    action = harmonyInputFindPrevious
                )

                HarmonyInputFindStepButton(
                    symbol = Symbol.CaretDown,
                    action = harmonyInputFindNext
                )

                ControlSlot() {
                    Icon(.X)
                        .imageScale(.Small)
                        .foregroundColor(.Secondary)
                }
                .onClick(harmonyInputFindCloseBar)
            }
            .fillHeight()
            .inset(horizontal = Spacing.Small)
        }
        .backgroundStyle(.Surface)
        .height(harmonyInputFindBarHeight())
    }
}

// What a shell puts under its toolbar. It occupies nothing at all while no find
// session is open, so the page keeps every pixel it had.
Widget HarmonyInputFindBarSlot() {
    body {
        VStack(spacing = Spacing.None) {
            if harmonyInputFindIsOpen() {
                HarmonyInputFindBar()

                Divider()
                    .themeBorder(.Subtle)
            }
        }
        .hugHeight()
    }
}

// How much of the window the find bar is taking, in points. The page's own
// window is inset by it, so the bar never covers what is being searched.
function harmonyInputFindBarInset() -> Float {
    if harmonyInputFindIsOpen() == false {
        return 0.0
    }
    return harmonyInputFindBarHeight() + 1.0
}
