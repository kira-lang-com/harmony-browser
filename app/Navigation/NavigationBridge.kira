function hbNavHistoryURL(tab: I32, index: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_history_title; abi: c; }
function hbNavHistoryTitle(tab: I32, index: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_navigate; abi: c; }
function hbNavNavigate(tab: I32, url: CString) -> Void;

