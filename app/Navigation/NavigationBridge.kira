function hbNavProvisionalURL(tab: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_title; abi: c; }
function hbNavTitle(tab: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_progress; abi: c; }
function hbNavProgress(tab: I32) -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_is_loading; abi: c; }
function hbNavIsLoading(tab: I32) -> I32;

