// The navigation model's C surface, one declaration per export.
//
// Everything here is a read of, or a write to, state the WebKit thread owns.
// Reads answer from a snapshot and never enter WebKit; writes are queued and
// run on the WebKit thread. So a widget may call any of them during a build
// without the frame waiting on a page.
//
// Nothing outside this file calls these directly: `NavigationState.kira` is
// where a caller finds them, with Kira types and the active tab as a default.

@FFI.Extern { library: harmony_browser; symbol: hb_nav_active_tab; abi: c; }
function hbNavActiveTab() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_for_slot; abi: c; }
function hbNavTabForSlot(slot: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_count; abi: c; }
function hbNavTabCount() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_id_at; abi: c; }
function hbNavTabIdAt(index: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_slot; abi: c; }
function hbNavTabSlot(tab: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_url; abi: c; }
function hbNavURL(tab: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_nav_committed_url; abi: c; }
function hbNavCommittedURL(tab: I32) -> CString;

