@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_count; abi: c; }
function hbDataRecordCount() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_origin; abi: c; }
function hbDataRecordOrigin(index: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_host; abi: c; }
function hbDataRecordHost(index: I32) -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_size; abi: c; }
function hbDataRecordSize(index: I32) -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_types; abi: c; }
function hbDataRecordTypes(index: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_record_last_used; abi: c; }
function hbDataRecordLastUsed(index: I32) -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_records_total_size; abi: c; }
function hbDataRecordsTotalSize() -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_type_size; abi: c; }
function hbDataTypeSize(kind: I32) -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_now; abi: c; }
function hbDataNow() -> Float;

// --- Removal -----------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_remove_origin; abi: c; }
function hbDataRemoveOrigin(origin: CString) -> Void;

