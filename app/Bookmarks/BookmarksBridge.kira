// The history and bookmarks module's C surface, one declaration per export.
//
// Everything here is a read of, or a write to, a model the module holds behind
// its own lock. Reads answer from that model and never enter WebKit or touch
// disk; writes change it and leave the file to a worker. So a widget may call
// any of them during a build without the frame waiting on a page or on a
// directory walk.
//
// Nothing outside this file calls these directly: `HistoryList.kira`,
// `BookmarksTree.kira` and `AddressSuggestions.kira` are where a caller finds
// them, with Kira types and the browser's own defaults.

// --- Lifecycle ---------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_attach; abi: c; }
function hbBookmarksAttach() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_shutdown; abi: c; }
function hbBookmarksShutdown() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_ready; abi: c; }
function hbBookmarksReady() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_error; abi: c; }
function hbBookmarksError() -> CString;

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_now; abi: c; }
function hbBookmarksNow() -> Float;

@FFI.Extern { library: harmony_browser; symbol: hb_bookmarks_revision; abi: c; }
function hbBookmarksRevision() -> I32;

