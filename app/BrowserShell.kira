import KiraUI

// The browser's window: what is above the page, what is beside it, what floats
// over it, and the hole in the middle the page's own window shows through.
//
// A page is a native child window of this one, composited above everything KiraUI
// paints. So the window never draws over the page: the rectangle the page
// occupies is left empty, everything the browser has to say goes above it or
// beside it, and anything that genuinely has to cover it goes into a layer that
// takes the page's window down for as long as it is up.
//
// Nothing here reaches an engine. Every control is a system's own widget, placed;
// every measurement comes from `BrowserState.kira`, which is where the window's
// arithmetic lives.

// --- The toolbar's leading run ------------------------------------------------

// Which arrangement the tabs are in. One control, because there are two
// arrangements and no third state worth a menu.
Widget HarmonyBrowserLayoutToggle() {
    body {
        ControlSlot(active = harmonyBrowserUsesSidebar()) {
            Icon(harmonyBrowserLayoutSymbol())
                .imageScale(.Small)
        }
        .onClick(harmonyBrowserToggleLayout)
    }
}

// The controls the window keeps at the leading end of the toolbar: the
// arrangement, a private tab, and the three surfaces that are about the browser
// rather than about the page. They are on the toolbar rather than in the sidebar
// because the sidebar is one of two arrangements, and a control that vanished
// with the tab list would be a control with no way back.
//
// The zoom badge is here only while a site is being read at anything but its own
// size, which is the only time a badge like it has ever been shown, and
// `harmonyChromeLeadingSlots` counts it so the address bar is sized against the
// row that is actually drawn.
Widget HarmonyBrowserToolbarControls() {
    body {
        HStack(spacing = Spacing.Small, alignment = VerticalAlignment.Center) {
            HarmonyBrowserLayoutToggle()

            PrivateBrowsingControl()

            DownloadsButton()

            PermissionPanelButton()

            ClearBrowsingDataControl()

            HarmonyBrowserMenuButton()

            if harmonyInputZoomIsDefault() == false {
                HarmonyInputZoomBadge()
            }
        }
        .hugWidth()
    }
}

// --- The page's own area ------------------------------------------------------

// Why there is no page, when there is none.
//
// A browser whose engine never loaded is otherwise a browser drawing an empty
// window, and the difference between that and a browser that is still starting is
// exactly what the host's diagnostic says.
Widget HarmonyBrowserStartupNotice() {
    body {
        Card(material = Material.Frosted) {
            Inset(horizontal = Spacing.Medium, vertical = Spacing.Small) {
                HStack(spacing = Spacing.Small, alignment = VerticalAlignment.Center) {
                    Icon(harmonyBrowserStartupSymbol())
                        .imageScale(.Medium)
                        .foregroundColor(harmonyBrowserStartupInk())

                    Text(harmonyBrowserStartupText())
                        .typography(.subheadline)
                        .foregroundColor(.Secondary)
                }
            }
        }
        .backgroundStyle(.Raised)
        .themeBorder(.Subtle)
        .hugWidth()
        .hugHeight()
    }
}

// The hole the page shows through.
//
// It paints the window's own surface and nothing else while a page is showing:
// whatever were drawn here would be underneath the page's window and invisible,
// and drawing it anyway is how a browser ends up with a interface it can only see
// when the engine is broken.
Widget HarmonyBrowserPageArea() {
    body {
        ZStack(alignment = StackAlignment.Center) {
            BackgroundFill(style = .Window)

            if harmonyBrowserPageIsShowing() == false {
                HarmonyBrowserStartupNotice()
            }
        }
        .fillHeight()
    }
}

// --- What floats over the page ------------------------------------------------

// The site menu, the downloads list and the clear-browsing-data panel, anchored
// under the controls that open them. They are the window's own layer rather than
// the dialogs one because none of them is a page's question: nothing is waiting on
// them, and a press anywhere else leaves them open.
//
// Each draws nothing at all while it is closed, so the column they share is the
// height of whichever of them is up.
//
// The column hangs under the toolbar rather than at the top of the window,
// because the toolbar is where the controls that open them are and a panel drawn
// over its own button is a panel that cannot be closed. The offset is a fill of
// the toolbar's height: `Inset` takes spacing tokens, and this is a measurement.
Widget HarmonyBrowserPanelLayer() {
    body {
        ZStack(alignment = StackAlignment.TopLeading) {
            VStack(spacing = Spacing.None, alignment = HorizontalAlignment.Leading) {
                BackgroundFill(style = .Clear)
                    .height(harmonyChromeHeight())

                Inset(horizontal = Spacing.Small, vertical = Spacing.Small) {
                    VStack(spacing = Spacing.Small, alignment = HorizontalAlignment.Leading) {
                        HarmonyBrowserMenuSlot()

                        DownloadsPanel()

                        ClearDataPanel()
                    }
                    .hugHeight()
                }
            }
            .hugHeight()
        }
    }
}

// --- The window ---------------------------------------------------------------

// Everything above the page, in the order it is stacked: the toolbar and its load
// lane, the tab strip when the tabs are across the top, and the find bar for as
// long as a find session is open. `harmonyBrowserTopInset` measures exactly this,
// and the page's own window is placed under it.
Widget HarmonyBrowserHeader() {
    body {
        VStack(spacing = Spacing.None) {
            HarmonyBrowserChrome() {
                HarmonyBrowserToolbarControls()
            }

            if harmonyBrowserUsesSidebar() == false {
                HarmonyTabStrip()
            }

            HarmonyInputFindBarSlot()
        }
        .hugHeight()
    }
}

Widget HarmonyBrowserBody() {
    body {
        VStack(spacing = Spacing.None) {
            HarmonyBrowserHeader()

            Expanded(flex = 1) {
                HStack(spacing = Spacing.None, alignment = VerticalAlignment.Stretch) {
                    if harmonyBrowserUsesSidebar() {
                        HarmonyBrowserSidebar()
                    }

                    Expanded(flex = 1) {
                        HarmonyBrowserPageArea()
                    }
                }
                .fillHeight()
            }
        }
        .fillHeight()
    }
}

// The window itself: the browser, the panels it floats, and the layer a page's
// own questions arrive in, in the order they cover one another.
Widget HarmonyBrowserWindow() {
    body {
        AppSurface {
            ZStack(alignment = StackAlignment.TopLeading) {
                HarmonyBrowserBody()

                if harmonyBrowserPanelsOpen() {
                    HarmonyBrowserPanelLayer()
                }

                HarmonyBrowserOverlay()
            }
            .fillHeight()
        }
    }
}
