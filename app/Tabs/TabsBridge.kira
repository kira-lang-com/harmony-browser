// The tab registry lives in native code because tabs are not only opened from
// here: a page that follows a target=_blank link or calls window.open creates
// one from inside WebKit, and a list kept only in Kira could not see that
// happen. So the registry is the truth, and this file is the two-way seam --
// the commands that change it, and the copy of it this side reads back.
//
// Every command below returns immediately. Reading the list back after issuing
// one shows the state before it: the widget tree rebuilds every frame, so the
// change shows on the next one.

// --- Engine lifetime --------------------------------------------------------
//
// Starting the engine belongs to the browser's host, which has five other systems
// to register with this one first. What is declared here is what the widgets ask
// afterwards: whether it came up, and why it did not.

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_ready; abi: c; }
function nativeTabsReady() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_shutdown; abi: c; }
function nativeTabsShutdown() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_error; abi: c; }
function nativeTabsError() -> CString;

// --- Opening and closing ----------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_open; abi: c; }
function nativeTabsOpen(url: CString, foreground: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_open_at; abi: c; }
function nativeTabsOpenAt(url: CString, index: I32, foreground: I32) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_close; abi: c; }
function nativeTabsClose(tabId: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_close_others; abi: c; }
function nativeTabsCloseOthers(tabId: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_close_all; abi: c; }
function nativeTabsCloseAll() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_reopen_closed; abi: c; }
function nativeTabsReopenClosed() -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_closed_count; abi: c; }
function nativeTabsClosedCount() -> I32;

// --- Selection --------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_select; abi: c; }
function nativeTabsSelect(tabId: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_select_index; abi: c; }
function nativeTabsSelectIndex(index: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_select_next; abi: c; }
function nativeTabsSelectNext() -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_select_previous; abi: c; }
function nativeTabsSelectPrevious() -> Void;

// --- Ordering ---------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_move; abi: c; }
function nativeTabsMove(tabId: I32, toIndex: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_set_pinned; abi: c; }
function nativeTabsSetPinned(tabId: I32, pinned: I32) -> Void;

// --- Navigation -------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_load; abi: c; }
function nativeTabsLoad(tabId: I32, url: CString) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_go_back; abi: c; }
function nativeTabsGoBack(tabId: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_go_forward; abi: c; }
function nativeTabsGoForward(tabId: I32) -> Void;

@FFI.Extern { library: harmony_browser; symbol: hb_tabs_reload; abi: c; }
