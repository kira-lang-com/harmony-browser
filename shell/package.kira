Package HarmonyShell {
    let version = "0.1.0"
    let kira = "0.1.0"
    let kind = PackageKind.App
    let defaults = Defaults { executionMode: Backend.Llvm, buildTarget: BuildTarget.Host }
    let allowThinFfiShim = true
    let dependencies = [
        Dependency { name: "KiraUI", path: "../../kira-ui" },
        Dependency { name: "OpacityUI", path: "../../opacity-ui" },
        Dependency { name: "KiraGraphics", path: "../../kira-graphics" },
        Dependency { name: "HarmonyCore", path: "../core" }
    ]
}
