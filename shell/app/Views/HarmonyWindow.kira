import HarmonyCore
import KiraUI

// The window.
//
// Two columns and a bar, and the split view owns all three: the columns are its
// slots, and the bar is assembled from what the columns declare with
// `.toolbar(...)`. That is what keeps a sidebar item and a document item on one
// baseline without either column knowing the other exists -- and it is why
// nothing here states a sidebar width or a toolbar height.
//
// Placement is by ROLE, and the roles are what decide where things land:
//
//   Navigation     over the sidebar, against the boundary with the document
//   Principal      the leading run of the document's own section
//   PrimaryAction  the trailing end of the bar
//
// The page's own controls are Principal rather than Navigation, because a
// Navigation item sits over the SIDEBAR whichever column declared it: back and
// forward filed there would be back and forward for the tab list.
construct HarmonyWindow() extends Widget {
    @State var path: NavigationPath = NavigationPath {}

    body {
        // Band 2 over bands 0 and 1: every component's content, then the
        // window's own, then whichever component overlay was raised last.
        //
        // The window's OWN overlay is not in this stack and does not need to be.
        // A menu KiraUI presents is drawn from a later stream than anything in
        // the tree, so the shell is above this by construction rather than by
        // an ordering somebody has to maintain -- which is the only way "the
        // shell is always on top" survives somebody editing this file.
        ZStack(alignment = StackAlignment.TopLeading) {
            NavigationSplitView(columnVisibility = harmonyShellColumns(), path = path) {
                SidebarView()
                    .toolbar {
                        ToolbarItem(placement = .Navigation) {
                            ToolbarGlyph(symbol = .SidebarLeft, enabled = true)
                                .onClick(harmonyShellToggleSidebar)
                        }
                        ToolbarItem(placement = .Navigation) {
                            ToolbarGlyph(symbol = .Plus, enabled = harmonyLinkIsWell(harmonyShellBrowser()))
                                .onClick(harmonyShellNewTab)
                        }
                    }
            } detail: {
                DetailView()
                    .toolbar {
                        ToolbarItem(placement = .Principal) {
                            ToolbarGlyph(symbol = .ArrowLeft, enabled = false)
                        }
                        ToolbarItem(placement = .Principal) {
                            ToolbarGlyph(symbol = .ArrowRight, enabled = false)
                        }
                        ToolbarItem(placement = .Principal) {
                            ToolbarGlyph(symbol = .ArrowClockwise, enabled = harmonyLinkIsWell(harmonyShellBrowser()))
                        }
                        ToolbarItem(placement = .Principal) {
                            AddressField(text = addressFieldPlaceholder(), secure = false)
                        }
                        ToolbarItem(placement = .PrimaryAction) {
                            AiToolbarButton(link = harmonyShellAi())
                        }
                    }
            }

            if harmonyShellOverlayTexture() > 0 {
                TextureViewport(texture = harmonyShellOverlayTexture())
                    .width(harmonyShellOverlayWidth())
                    .height(harmonyShellOverlayHeight())
            }
        }
    }
}
