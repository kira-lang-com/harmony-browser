import KiraUI

// A quiet label over a run of rows.
//
// There is no wordmark widget here and there should not be. What the column is
// called is set with `.navigationTitle(...)` and drawn by the WINDOW's bar, at
// the same weight and on the same baseline as the document's own title. A
// heading painted inside the column would be a second answer to the same
// question, one gap lower and in whatever size this file happened to choose.
construct SidebarSectionLabel(title: String) extends Widget {
    body {
        Inset(horizontal = Spacing.Small, vertical = Spacing.None) {
            HStack(spacing = Spacing.None, alignment = VerticalAlignment.Center) {
                Text(title)
                    .typography(.overline)
                    .foregroundColor(.Tertiary)

                Spacer()
            }
            .height(28.0)
        }
    }
}
