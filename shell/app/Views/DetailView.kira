import HarmonyCore
import KiraUI

// The window's document column: where a component's surface is composited.
//
// A component renders into a texture and the shell draws it here. Until one has
// handed a surface over there is nothing to composite, and this says what is
// missing rather than showing an empty rectangle -- which is the difference
// between an application that is starting and one that is broken.
Widget DetailView() {
    body {
        ZStack(alignment = StackAlignment.Center) {
            BackgroundFill(style = .Window)

            // The component's own pixels, composited straight out of the memory
            // it rendered them into. Nothing is copied between the two
            // processes: what the browser drew is the image sampled here.
            //
            // The gate is whether there is anything to COMPOSITE, not whether a
            // component is running. They are different questions: a browser is
            // running for several frames before it has a page to hand over, and
            // a column that went blank the moment the component attached would
            // be blank for exactly the period a person is waiting to be told
            // what is happening.
            HStack(spacing = Spacing.None, alignment = VerticalAlignment.Stretch) {
                Expanded(flex = 1) {
                    ZStack(alignment = StackAlignment.Center) {
                        if harmonyShellDocumentTexture() > 0 {
                            TextureViewport(texture = harmonyShellDocumentTexture())
                        } else {
                            NoSurfaceView()
                        }
                    }
                    .fillHeight()
                }

                // Ask AI, when the window has opened it. Its own texture beside
                // the document rather than over it: a panel drawn over the page
                // is a panel that hides what it is being asked about.
                if harmonyShellInspectorTexture() > 0 {
                    TextureViewport(texture = harmonyShellInspectorTexture())
                        .width(harmonyShellInspectorTextureWidth())
                }
            }
            .fillHeight()
        }
        .fillHeight()
    }
}

// What the document column says when no component is drawing into it.
//
// One mark, one sentence, one instruction. The components are already listed in
// the sidebar, so they are not listed again here: a person reading this needs to
// know what to DO, and a second copy of the status is not that.
Widget NoSurfaceView() {
    body {
        VStack(spacing = Spacing.Medium, alignment = HorizontalAlignment.Center) {
            // An icon is sized from the TYPE in effect, not from a length:
            // `iconScaleSize` multiplies the scale by the cap band of the
            // current face. So a hero mark is set the way a hero line is --
            // by naming its typography -- and `.size(...)` would only grow the
            // box around a glyph that stayed exactly as small.
            Icon(.Globe)
                .typography(.title1)
                .imageScale(.ExtraLarge)
                .foregroundColor(.Quaternary)

            FixedGap(width = 1.0, height = 2.0)

            Text(noSurfaceHeadline())
                .typography(.title2)

            Text(noSurfaceExplanation())
                .typography(.subheadline)
                .foregroundColor(.Secondary)
        }
        .hugWidth()
        .hugHeight()
    }
}

// What is missing, in three or four words.
function noSurfaceHeadline() -> String {
    match harmonyShellBrowser().state {
        Absent -> return "No web engine";
        Idle -> return "Web engine ready";
        Starting -> return "Starting the web engine";
        Ready -> return "Waiting for the first page";
        Refused -> return "Web engine out of date";
        Lost -> return "The web engine stopped";
    }
}

// Why, in one sentence a person can act on.
function noSurfaceExplanation() -> String {
    let browser = harmonyShellBrowser()
    match browser.state {
        Absent -> return "Install Harmony Browser beside this shell to open pages.";
        Idle -> return "Harmony Browser is installed and has not started yet.";
        Starting -> return "It will appear here as soon as it is ready.";
        Ready -> return "Harmony Browser is running and has not sent a surface yet.";
        Refused -> return browser.note;
        Lost -> return browser.note;
    }
}
