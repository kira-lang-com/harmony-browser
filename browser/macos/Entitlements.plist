<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The web-browser entitlement is what WebKit gates the platform
	     passkey authenticator on: without it, a WKWebView answers
	     isUserVerifyingPlatformAuthenticatorAvailable() with false and no
	     site offers a passkey. Signed into the build by
	     scripts/run-macos.sh. -->
	<key>com.apple.developer.web-browser</key>
	<true/>
</dict>
</plist>
