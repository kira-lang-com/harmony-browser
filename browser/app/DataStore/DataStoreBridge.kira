// The data store's C surface, one declaration per export.
//
// Everything here is a read of, or a request against, state the WebKit thread
// and the profile's own disk worker own. Reads answer from a published
// snapshot and never enter WebKit or touch disk; requests are queued and
// serviced on those threads. So a widget may call any of them during a build
// without the frame waiting on a page or on a directory walk.
//
// Nothing outside this file calls these directly: `DataStoreState.kira` is
// where a caller finds them, with Kira types and the panel's own selection as
// arguments.

// --- Lifecycle ---------------------------------------------------------------

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_ready; abi: c; }
function hbDataReadyEngine() -> I32;

// Guarded: a build with no engine answers without calling it.
function hbDataReady() -> I32 {
    if harmonyBrowserEngineAvailable() == false {
        return I32(0)
    }
    return hbDataReadyEngine()
}

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_shutdown; abi: c; }
function hbDataShutdownEngine() -> Void;

// Guarded: a build with no engine answers without calling it.
function hbDataShutdown() {
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    hbDataShutdownEngine()
    return
}

@FFI.Extern { library: harmony_browser; symbol: hb_data_store_profile_path; abi: c; }
function hbDataProfilePathEngine() -> CString;

// Guarded: a build with no engine answers without calling it.
function hbDataProfilePath() -> String {
    if harmonyWebEngineActive() {
        return HarmonyWebProfile().directory()
    }
    if harmonyBrowserEngineAvailable() == false {
        return ""
    }
    return hbDataProfilePathEngine()
}

