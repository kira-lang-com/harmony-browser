import KiraGraphics

// The seam onto the browser's native host, and the order a browser's frame runs
// in.
//
// The host is what joins every system of this browser to the engine: it
// registers their hooks with the tab registry before the registry creates its
// first page, and it fills the client fields no single system owns. What is left
// for this side is the ORDER, which is a browser-level decision and belongs where
// the browser is composed rather than inside any one system.
@FFI.Extern { library: harmony_browser; symbol: hb_browser_frame; abi: c; }
function nativeBrowserFrame(
    hostWindow: RawPtr,
    x: I32,
    y: I32,
    width: I32,
    height: I32,
    backingScale: Float,
    homeURL: CString,
) -> I32;

@FFI.Extern { library: harmony_browser; symbol: hb_browser_ready; abi: c; }
function nativeBrowserReadyEngine() -> I32;

// Guarded: a build with no engine answers without calling it.
function nativeBrowserReady() -> I32 {
    if harmonyBrowserEngineAvailable() == false {
        return I32(0)
    }
    return nativeBrowserReadyEngine()
}

@FFI.Extern { library: harmony_browser; symbol: hb_browser_error; abi: c; }
function nativeBrowserErrorEngine() -> CString;

// Guarded: a build with no engine answers without calling it.
function nativeBrowserError() -> String {
    if harmonyBrowserEngineAvailable() == false {
        return ""
    }
    return nativeBrowserErrorEngine()
}

// Whether this build has the Windows archive behind its seams at all.
//
// `harmony_browser` is Windows-only: two thirds of its sources reach either the
// WebKit C API or Win32, and its manifest declares no row for anything else. A
// call into a library a target excludes traps by name, so this has to be asked
// before the call rather than answered by it -- which is what every guarded
// wrapper in the bridges below does.
function harmonyBrowserEngineAvailable() -> Bool {
    return KiraGraphics.hostPlatform() == KiraGraphics.Platform.Windows
}

// Whether THIS build carries the Apple port of the engine.
//
// This is the second port the seam above was written waiting for, and it lives
// somewhere the first one does not: in Kira itself. There is no archive behind
// it -- AppKit and WebKit are driven straight through the Objective-C runtime
// from `app/WebEngine/`, the way Kira Graphics drives Metal -- so the question
// it answers is not "does the native half exist" but "does a page render here".
// The two questions stay separate because every guarded wrapper in the bridges
// keys on the first, and on an Apple host those wrappers must keep answering
// their no-archive values for everything the port does not yet carry.
function harmonyWebEngineActive() -> Bool {
    return KiraGraphics.hostPlatform() == KiraGraphics.Platform.MacOS
}

// Whether the engine is up and serving commands.
function harmonyBrowserReady() -> Bool {
    if harmonyWebEngineActive() {
        return HarmonyWebEngine().isAttached()
    }
    if harmonyBrowserEngineAvailable() == false {
        return false
    }
    return nativeBrowserReady() != I32(0)
}

// Why the browser is not showing a page, or "" when nothing is wrong. The system
// with something to say answers, starting with the one that owns the engine.
function harmonyBrowserDiagnostic() -> String {
    if harmonyWebEngineActive() {
        // The port has no engine thread to fail to start and no archive to be
        // missing; what can go wrong with it shows up as a page that has not
        // loaded, which the page's own error surface will say once the port
        // grows one. Nothing here has anything to add yet.
        return ""
    }
    if harmonyBrowserEngineAvailable() == false {
        return "This build has no WebKit engine: the browser's native half is Windows-only."
    }
    return nativeBrowserError()
}

// Runs once per frame, before the widget tree is built.
//
// The order is the whole of this function, and every step of it is a requirement
// rather than a preference:
//
// 1. The keyboard. What it drains here is what the rest of this frame acts on,
//    so a Ctrl+T and the tab it opens land in the same frame rather than a frame
//    apart. Its hooks are registered by the host rather than by this order, so
//    moving this step cannot cost a page its focus client.
//
// 2. The engine. One measurement of the page's rectangle, one scale, one start:
//    the host applies the geometry before it asks the registry to start, so the
//    first tab is created at the size it will be shown at. Nothing else in this
//    browser sets those, so the view is never moved twice in a frame and the run
//    loop is never cycled by two threads.
//
// 3. The title bar, which the widget tree does not draw.
//
// 4. The question a page is waiting on. The dialogs wrapper is told whether the
//    browser is drawing anything of its own over the page this frame, because a
//    page's view is a child window composited above everything KiraUI paints and
//    an overlay is only visible while that window is down.
//
// 5. The session, which opens the tabs the last run was closed with once the
//    registry has a tab of its own to give the first entry.
//
// The permissions pump comes before the engine rather than after it. Its first
// call is what reads the remembered answers off disk and publishes them, and a
// page that asks for the camera before that table exists is a page prompted about
// a site the user already answered for.
function harmonyBrowserFrame(frame: borrow mut KiraGraphics.RenderFrame) {
    // The Apple port's frame: attach, drain, size, act, read back. Its engine
    // runs on this very thread, so the pass is a function call and not a hand-
    // off -- which is also why the guarded steps below it stay out of its way.
    if harmonyWebEngineActive() {
        harmonyWebEngineFrame(frame)
        // The session restore runs here too: the port's registry answers ready
        // from its first frame, and the restore adopts that tab onto the URL
        // the last run left. A first run has no session file, and the restore
        // answers zero tabs, leaving the home page the attach already queued.
        harmonyDataStoreFrame()
        harmonyChromeFrame(frame)
        return
    }

    let window = KiraGraphics.kiraGraphicsHostWindowHandle(frame)
    if pointerIsNull(window) {
        return
    }

    // Every step below reaches the engine. Without one there is nothing to keep
    // in step with the window, and the chrome draws around an empty page area
    // rather than not drawing at all.
    if harmonyBrowserEngineAvailable() == false {
        harmonyChromeFrame(frame)
        return
    }

    harmonyInputFrame(frame)
    harmonyPermissionPump()

    var scale = KiraGraphics.kiraGraphicsHostBackingScale(frame)
    if scale <= 0.0 {
        scale = 1.0
    }
    let rect = harmonyBrowserPageRect(frame)
    let ignoredReady = nativeBrowserFrame(
        window,
        rect.x,
        rect.y,
        rect.width,
        rect.height,
        scale,
        harmonyTabsHomeURL()
    )

    harmonyChromeFrame(frame)

    harmonyDialogsFrame(frame, harmonyBrowserOverlayIsUp())

    harmonyDataStoreFrame()
    return
}

// Runs once, after the runner returns, at the end of the process.
//
// The order is each system's own requirement: a page left waiting on an answer is
// a web process that never exits, the last session write reads a tab list the
// registry clears on its way down, and the input hooks are removed from the two
// threads that carry them while both threads are still there. The registry that
// owns the engine goes last, and takes the download engine and the navigation
// model down from its own teardown hooks on the way.
function harmonyBrowserShutdown() {
    if harmonyWebEngineActive() {
        harmonyWebEngineShutdown()
        return
    }
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    harmonyInputShutdown()
    harmonyPermissionShutdown()
    harmonyDialogsShutdown()
    harmonyDataStoreShutdown()
    harmonyTabsShutdown()
    return
}
