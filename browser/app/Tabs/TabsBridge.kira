// --- The Kira-side surface --------------------------------------------------
//
// C counts in 32 bits and Kira in 64, and the widget tree indexes, compares and
// prints in Kira's. The conversion belongs here, once, rather than at every
// call site.

function harmonyTabsFlag(value: Bool) -> I32 {
    if value {
        return I32(1)
    }
    return I32(0)
}

function harmonyTabsCount() -> Int {
    return Int(nativeTabsCount())
}

function harmonyTabsRevision() -> Int {
    return Int(nativeTabsRevision())
}

function harmonyTabsIdAt(index: Int) -> Int {
    return Int(nativeTabsIdAt(I32(index)))
}

function harmonyTabsIndexOf(tabId: Int) -> Int {
    return Int(nativeTabsIndexOf(I32(tabId)))
}

function harmonyTabsActiveId() -> Int {
    return Int(nativeTabsActiveId())
}

function harmonyTabsActiveIndex() -> Int {
    return Int(nativeTabsActiveIndex())
}

function harmonyTabsClosedCount() -> Int {
    return Int(nativeTabsClosedCount())
}

function harmonyTabsReady() -> Bool {
    return nativeTabsReady() != I32(0)
}

function harmonyTabsError() -> String {
    return nativeTabsError()
}

// --- Driving the engine from a frame ----------------------------------------
//
// Starting the engine and placing the view are NOT here.
//
// The registry is one of six systems the browser has to bring up in an order none
// of them can see -- every other system's hooks have to be registered before this
// one creates its first page -- and the rectangle its view occupies depends on
// what the window put above and beside the page, which this file cannot know
// either. So all of it happens in one place, in the browser's host: see
// `hb_browser_frame` in `NativeLibs/harmony_webkit.h`, and `harmonyBrowserFrame`
// in `app/WebKitBridge.kira` for the order around it.
//
// What is left here is the list and the commands, which is what the widgets read.

// Runs at the end of the process. The WebKit thread and the two processes each
// tab holds open are not the host's to reap, so the host has to say when it is
// done with them.
function harmonyTabsShutdown() {
    nativeTabsShutdown()
    return
}

// The address a tab opened with no URL of its own loads. The host hands it to the
// registry on every frame call, so the registry never holds a home the browser
// has forgotten it set.
function harmonyTabsHomeURL() -> String {
    return "https://www.google.com/"
}
