// --- The Kira-side surface ----------------------------------------------------
//
// C counts in 32 bits and Kira in 64, and the widget tree indexes, compares and
// prints in Kira's. The conversion belongs here, once, rather than at every call
// site.

// The two roots, spelled once. These are the values in `harmony_bookmarks.h`,
// and the two must agree.
function harmonyBookmarksBarFolder() -> Int {
    return 1
}

function harmonyBookmarksOtherFolder() -> Int {
    return 2
}

// How a query is matched. These are the values in `harmony_bookmarks.h`.
function harmonyHistoryMatchPrefix() -> Int {
    return 0
}

function harmonyHistoryMatchSubstring() -> Int {
    return 1
}

function harmonyBookmarksRevision() -> Int {
    return Int(hbBookmarksRevision())
}

function harmonyBookmarksReady() -> Bool {
    return hbBookmarksReady() != I32(0)
}

function harmonyBookmarksError() -> String {
    return hbBookmarksError()
}

// Seconds since the Unix epoch, on the clock every stored time is stamped with.
function harmonyBookmarksNow() -> Float {
    return hbBookmarksNow()
}
