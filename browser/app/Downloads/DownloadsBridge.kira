// --- The Kira-side surface ---------------------------------------------------

// Bumped on every change the panel would draw differently, including a byte
// count arriving.
function downloadsRevision() -> Int {
    return Int(downloadsNativeRevision())
}

// The text fields, in the order harmony_downloads.h numbers them.
function downloadFieldUrl() -> Int {
    return 0
}

function downloadFieldFileName() -> Int {
    return 1
}

function downloadFieldPath() -> Int {
    return 2
}

function downloadFieldMimeType() -> Int {
    return 3
}

function downloadFieldError() -> Int {
    return 4
}

function downloadFieldCompleted() -> Int {
    return 5
}

function downloadTextOf(id: Int, field: Int) -> String {
    return downloadsNativeText(I32(id), I32(field))
}

// Where files are saved. A folder that could not be created answers with
// nothing rather than with a path that is not there.
function downloadsDirectoryPath() -> String {
    return downloadsNativeDirectory()
}
