// The one conversion the Apple branch above needs that the archive's callers
// did not: its snapshot carries Kira bools, and these seams answer C ints.
function harmonyWebFlag(value: Bool) -> I32 {
    if value {
        return I32(1)
    }
    return I32(0)
}
