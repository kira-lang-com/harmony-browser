@FFI.Extern { library: harmony_browser; symbol: hb_nav_history_count; abi: c; }
function hbNavHistoryCountEngine(tab: I32) -> I32;

// Guarded: a build with no engine answers without calling it.
function hbNavHistoryCount(tab: I32) -> I32 {
    if harmonyWebEngineActive() {
        // The back/forward list is not read off the view yet; the toolbar's
        // two buttons are driven by canGoBack/canGoForward, which are.
        return I32(0)
    }
    if harmonyBrowserEngineAvailable() == false {
        return I32(0)
    }
    return hbNavHistoryCountEngine(tab)
}

