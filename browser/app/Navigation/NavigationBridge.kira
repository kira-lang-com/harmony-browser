@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_id_at; abi: c; }
function hbNavTabIdAtEngine(index: I32) -> I32;

// Guarded: a build with no engine answers without calling it.
function hbNavTabIdAt(index: I32) -> I32 {
    if harmonyWebEngineActive() {
        if index == 0 {
            return I32(HarmonyWebEngine().shownTab())
        }
        return I32(0)
    }
    if harmonyBrowserEngineAvailable() == false {
