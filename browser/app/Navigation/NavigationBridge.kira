    return hbNavTabIdAtEngine(index)
}

@FFI.Extern { library: harmony_browser; symbol: hb_nav_tab_slot; abi: c; }
function hbNavTabSlotEngine(tab: I32) -> I32;

// Guarded: a build with no engine answers without calling it.
function hbNavTabSlot(tab: I32) -> I32 {
    if harmonyWebEngineActive() {
        if tab == HarmonyWebEngine().shownTab() {
            return I32(1)
        }
        return I32(0)
    }
    if harmonyBrowserEngineAvailable() == false {
        return I32(0)
    }
    return hbNavTabSlotEngine(tab)
}

@FFI.Extern { library: harmony_browser; symbol: hb_nav_url; abi: c; }
function hbNavURLEngine(tab: I32) -> CString;

// Guarded: a build with no engine answers without calling it.
function hbNavURL(tab: I32) -> String {
    if harmonyWebEngineActive() {
        return HarmonyWebEngine().currentURL(Int(tab))
    }
    if harmonyBrowserEngineAvailable() == false {
        return ""
    }
    return hbNavURLEngine(tab)
}

