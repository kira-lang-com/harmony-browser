@FFI.Extern { library: harmony_browser; symbol: hb_nav_reload_ignoring_cache; abi: c; }
function hbNavReloadIgnoringCacheEngine(tab: I32) -> Void;

// Guarded: a build with no engine answers without calling it.
function hbNavReloadIgnoringCache(tab: I32) {
    if harmonyWebEngineActive() {
        // The view's cache is not addressed separately yet; the reload is the
        // honest part of the ask that exists.
        HarmonyWebEngine().requestReload()
        return
    }
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    hbNavReloadIgnoringCacheEngine(tab)
    return
}

