@FFI.Extern { library: harmony_browser; symbol: hb_nav_navigate; abi: c; }
function hbNavNavigateEngine(tab: I32, url: CString) -> Void;

// Guarded: a build with no engine answers without calling it.
function hbNavNavigate(tab: I32, url: borrow String) {
    if harmonyWebEngineActive() {
        HarmonyWebEngine().requestNavigate(url)
        return
    }
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    hbNavNavigateEngine(tab, url)
    return
}

