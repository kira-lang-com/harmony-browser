// The context-menu system's C surface, one declaration per export.
//
// The menu itself is native, because the menu itself is Windows': WebKit's
// Windows port builds a real popup menu out of the items this browser hands
// back and tracks it over the page's own window. What crosses into Kira is not
// the menu but the DECISION -- "open this address in a new tab", "save this
// link" -- so the systems that own those actions carry them out through the same
// calls the rest of the interface uses.
//
// Nothing outside `app/Menus` calls these: `MenusCommands.kira` is where the
// browser finds them, in Kira types.

@FFI.Extern { library: harmony_browser; symbol: hb_menus_attach; abi: c; }
function nativeMenusAttachEngine() -> Void;

// Guarded: a build with no engine answers without calling it.
function nativeMenusAttach() {
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    nativeMenusAttachEngine()
    return
}

@FFI.Extern { library: harmony_browser; symbol: hb_menus_shutdown; abi: c; }
function nativeMenusShutdownEngine() -> Void;

// Guarded: a build with no engine answers without calling it.
function nativeMenusShutdown() {
    if harmonyBrowserEngineAvailable() == false {
        return
    }
    nativeMenusShutdownEngine()
    return
}

@FFI.Extern { library: harmony_browser; symbol: hb_menus_next_command; abi: c; }
function nativeMenusNextCommandEngine() -> I32;

// Guarded: a build with no engine answers without calling it.
function nativeMenusNextCommand() -> I32 {
    if harmonyBrowserEngineAvailable() == false {
        return I32(0)
    }
    return nativeMenusNextCommandEngine()
}

@FFI.Extern { library: harmony_browser; symbol: hb_menus_command_text; abi: c; }
function nativeMenusCommandTextEngine() -> CString;

// Guarded: a build with no engine answers without calling it.
function nativeMenusCommandText() -> String {
    if harmonyBrowserEngineAvailable() == false {
        return ""
    }
    return nativeMenusCommandTextEngine()
}

@FFI.Extern { library: harmony_browser; symbol: hb_menus_command_tab; abi: c; }
function nativeMenusCommandTabEngine() -> I32;

