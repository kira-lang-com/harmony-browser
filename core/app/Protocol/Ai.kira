import KiraIpc

// What the shell and the AI component say to each other.
//
// The runtime is PLUGGABLE and this is the seam that makes it so: nothing here
// names a model, a provider, a file on disk or a network. The shell asks what
// the component can do and sends it turns; the component answers with deltas.
// Whether the answer came from weights on this machine or from somewhere else
// is the component's business, and swapping one for the other changes nothing
// on this side.

function aiCapabilitiesMethod() -> String {
    return "ai.capabilities"
}

function aiSendMethod() -> String {
    return "ai.send"
}

function aiCancelMethod() -> String {
    return "ai.cancel"
}

// An event, not an answer. A turn produces many of these and the shell is not
// waiting on any one of them.
function aiDeltaMethod() -> String {
    return "ai.delta"
}

// What the component can do, asked once when it becomes ready.
//
// `runtimeReady` is separate from the component being attached, because they are
// different things: the AI component can be installed, running and talking while
// its runtime is still loading, or while it has no model to load. A shell that
// conflated them would offer a conversation that cannot be had.
@Derive(IpcMessage)
struct AiCapabilities {
    var runtimeReady: Bool
    // What to call the thing answering, for a person. Empty while nothing is
    // loaded.
    var model: String
    // Whether answers arrive as deltas or in one piece. A shell draws both, and
    // knowing which lets it decide whether to show a caret.
    var streaming: Bool
    // Why the runtime is not ready, when it is not. For a person.
    var note: String
}

// Which conversation a turn or a delta belongs to.
//
// A `distinct` type rather than a bare number, because a conversation is named
// by an identity, not counted: nothing about it is added, ordered against a
// length, or indexed into an array, and the compiler refuses the code that
// treats it as though it were. The one number inside is the shell's to mint and
// the component's only to echo, and `.raw` is the only way to reach it.
//
// The wire form is unchanged from the `struct ConversationId { var value: Int }`
// this used to be: `@Derive(IpcMessage)` writes a distinct type as the same
// one-field region, so a peer built against either declaration reads the other.
//
// Absence is a value of this type, not a second flag beside it: `conversationNone`
// is the id a session carries while nothing is in flight and the id a runtime
// answers with when it has nothing to send. It is the one id a shell must never
// open, which is why the mint side starts above it.
@Derive(IpcMessage)
distinct ConversationId = Int

// The id that names no conversation.
function conversationNone() -> ConversationId {
    return ConversationId(0)
}

// Whether this id names a conversation at all.
function conversationPresent(id: ConversationId) -> Bool {
    return id != conversationNone()
}

// Whether two ids name the same conversation.
function conversationSame(a: ConversationId, b: ConversationId) -> Bool {
    return a == b
}

// One thing a person said.
@Derive(IpcMessage)
struct AiTurn {
    // Which conversation this belongs to. A shell may have several open, and the
    // component answers each independently.
    var conversation: ConversationId
    var text: String
}

// Where a turn stands after this piece of it.
//
// Carried as one value rather than as a `done` flag beside a `failed` flag,
// because the two booleans describe four states and one of them -- failed but
// not finished -- is not a thing a turn can be.
@Derive(IpcMessage)
enum AiDeltaKind {
    // More is coming. A streaming runtime sends many of these.
    Continuing
    // The turn is over and the answer is complete.
    Finished
    // The turn is over because something went wrong. The delta's text is then
    // the reason, for a person to read.
    Failed
}

// A piece of an answer.
//
// A one-piece answer is a single delta that is already Finished, and a streamed
// one is many that end on it -- the shell draws both the same way and does not
// branch on which kind it is getting.
@Derive(IpcMessage)
struct AiDelta {
    var conversation: ConversationId
    var text: String
    var kind: AiDeltaKind
}

@Derive(IpcMessage)
struct AiCancel {
    var conversation: ConversationId
}
